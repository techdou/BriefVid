{
  "mcpServers": {
    "video-lecture": {
      "command": "python",
      "args": ["/path/to/video-lecture-skill/mcp_server.py"],
      "env": {
        "VLEC_OPENAI_API_KEY": "sk-your-api-key-here",
        "VLEC_OPENAI_BASE_URL": "https://api.openai.com/v1",
        "VLEC_OPENAI_MODEL": "gpt-4o-mini",
        "VLEC_TRANSCRIBE_MODE": "local",
        "VLEC_WHISPER_MODEL": "base",
        "VLEC_KNOWLEDGE_ENABLED": "false",
        "VLEC_OBSIDIAN_OUTPUT_DIR": ""
      }
    }
  }
}
